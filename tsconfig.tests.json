{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tests.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "packages/*/test/**/*",
    "packages/*/test-e2e/**/*",
    "tools/*/test/**/*",
    "packages/app/bench/**/*",
    "scripts/test-modes/shader-probe.ts",
    "tools/*/test-browser/**/*"
  ]
}
